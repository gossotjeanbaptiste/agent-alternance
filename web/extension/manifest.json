{
  "manifest_version": 3,
  "name": "LMAgent — formulaire La Bonne Alternance",
  "version": "1.0.0",
  "description": "Remplit le formulaire « Candidature simplifiée » de La Bonne Alternance avec les données de LMAgent (sur ce PC). N'envoie jamais rien, ne lit aucun cookie.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": [],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": { "service_worker": "service.js" },
  "content_scripts": [
    {
      "matches": ["https://labonnealternance.apprentissage.beta.gouv.fr/*"],
      "js": ["remplir.js", "contenu.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'" }
}
